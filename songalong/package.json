{
  "name": "songalong",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-prep.mjs && tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply songalong-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply songalong-db --remote",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "build:prep": "node scripts/build-prep.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "wrangler": "^4.151.2"
  }
}
